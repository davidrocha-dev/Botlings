# Copy to .env.local (repo root) and fill in. Never commit real values.

# Database. Leave DATABASE_URL empty to use the embedded PGlite database in ./data.
# With docker-compose: postgres://botlings:botlings@localhost:5432/botlings
DATABASE_URL=
REDIS_URL=redis://localhost:6379

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Licensing mode: personal | commercial
BOTLINGS_MODE=personal

# Group moderator: cheap paid model used only when the free ones fail (cents per 1000 rounds).
# BOTLINGS_MODERATOR_MODEL=qwen/qwen3.7-flash

# Telegram bot: create one with @BotFather and paste its token, then restart. Leave empty to disable.
TELEGRAM_BOT_TOKEN=


# Agent computers
# BOTLINGS_GATEWAY_PORT=3001
# BOTLINGS_MAX_ACTIVE_COMPUTERS=4
# BOTLINGS_COMPUTER_IDLE_MINUTES=15
# Agents cannot reach your LAN unless this is true
# BOTLINGS_COMPUTER_ALLOW_LAN=false

# Delegation (orchestrator -> agents)
# BOTLINGS_MAX_DELEGATIONS_PER_REQUEST=3
# BOTLINGS_TASK_MAX_COST_USD=0.05
# BOTLINGS_TASK_TIMEOUT_MINUTES=10

# Free model(s) for helper jobs ("Generate with AI", conversation summaries), comma-separated, tried in order
# BOTLINGS_UTILITY_MODEL=google/gemma-4-31b-it:free,z-ai/glm-5.2:free,nvidia/nemotron-3-super-120b-a12b:free,openrouter/free

# Key for encrypting secrets (base64, 32 bytes). If unset, one is generated in data/secret.key — back it up.
# BOTLINGS_SECRET_KEY=

# Web Push (VAPID) keys. If unset, a pair is generated in data/vapid.json — changing them means re-enabling notifications on every device.
# BOTLINGS_VAPID_PUBLIC_KEY=
# BOTLINGS_VAPID_PRIVATE_KEY=
# Contact the push services can reach (mailto: or https:).
# BOTLINGS_VAPID_SUBJECT=mailto:you@example.com
