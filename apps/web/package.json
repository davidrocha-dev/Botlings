{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm run \"/^dev:/\"",
    "dev:next": "next dev",
    "dev:gateway": "tsx watch --tsconfig tsconfig.json src/gateway/server.ts",
    "build": "next build",
    "start": "pnpm run \"/^start:/\"",
    "start:next": "next start",
    "start:gateway": "tsx --tsconfig tsconfig.json src/gateway/server.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "smoke": "tsx --tsconfig tsconfig.json scripts/smoke.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@next/env": "^16.3.5",
    "@node-rs/argon2": "^2.2.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.1",
    "dockerode": "^5.0.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.46.0",
    "motion": "^13.4.0",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
